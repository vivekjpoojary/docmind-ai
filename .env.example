# DocMind AI Environment Variables

# Backend Config
APP_ENV=production
SECRET_KEY=docmind_super_secret_jwt_key_change_me_in_production_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (SQLite default or PostgreSQL connection string)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# RAG & Vector Store Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional OpenAI Fallback (if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Admin Initial Account Seeding (Optional)
ADMIN_EMAIL=admin@docmind.ai
ADMIN_PASSWORD=change_me_secure_password_123

# CORS & Upload Limits
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,docx,txt

# Frontend Config
VITE_API_BASE_URL=https://your-backend.onrender.com/api/v1
